# Google Cloud / Google Drive API Credentials
# Create credentials in Google Cloud Console: https://console.cloud.google.com/
# 1. Enable Google Drive API & Google Picker API
# 2. Configure OAuth 2.0 Client ID (Web Application) with Authorized JavaScript Origins:
#    - http://localhost:5173
#    - https://your-project.vercel.app
# 3. Create an API Key with HTTP Referrer Restrictions

VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_GOOGLE_APP_ID=your-google-cloud-project-number
